# Строка подключения к PostgreSQL
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=barDb;Username=postgres;Password=YourSecurePassword123!

# Секретный путь для входа в админку (должен совпадать с VITE_GATEWAY_PATH на клиенте)
AUTH_GATEWAY_PATH=l1og9in_enter04

# Пароль администратора (при старте сервера автоматически хэшируется и сохраняется в БД)
ADMIN_PASSWORD=YourAdminPassword123!

# Секретный заголовок админ-клиента (должен совпадать с VITE_ADMIN_CLIENT_KEY на клиенте)
ADMIN_CLIENT_KEY=REPLACE_WITH_SECURE_KEY

# Секретный ключ JWT (не менее 32 символов)
JWT_KEY=YourSuperSecretJwtKeyMakeSureItsAtLeast32CharsLong!
JWT_ISSUER=BarServer
JWT_AUDIENCE=BarClient

# Разрешенные CORS-домены через запятую (например: https://mybar.ru,https://www.mybar.ru)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Режим SameSite для кук авторизации (lax - для одного домена/Nginx, none - если фронтенд и бэкенд на разных доменах по HTTPS)
COOKIE_SAME_SITE=lax
