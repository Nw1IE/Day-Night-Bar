# Базовый URL для API (по умолчанию /api для Nginx proxy, либо полный URL вроде https://api.mybar.ru/api)
VITE_API_URL=/api

# Базовый URL для статических картинок (по умолчанию /imgs)
VITE_IMAGES_URL=/imgs

# Секретный путь для входа в админку (должен совпадать с AUTH_GATEWAY_PATH на сервере)
VITE_GATEWAY_PATH=l1og9in_enter04

# Секретный заголовок админ-клиента (должен совпадать с ADMIN_CLIENT_KEY на сервере)
VITE_ADMIN_CLIENT_KEY=REPLACE_WITH_SECURE_KEY
